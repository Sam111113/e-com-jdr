# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files : jamais de secret dans le dépôt (voir .env.example)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stockage privé local (T1.5), jamais commité
/data/private

# Kits PDF des jeux : ce sont les produits vendus, ils ne doivent jamais
# partir sur GitHub. `npm run import-games` les déplace dans le stockage privé.
# Seul le kit du jeu factice (contenu de démonstration) est versionné.
content/games/*/kit.pdf
!content/games/jeu-factice-*/kit.pdf

# OpenCode : seules les skills du projet sont versionnées (OpenCode crée de
# lui-même package.json et node_modules dans ce dossier).
.opencode/*
!.opencode/skills/

# éditeurs
.vscode/*
!.vscode/extensions.json
.idea
