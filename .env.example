# Copier ce fichier en `.env` (jamais commité, voir .gitignore) et remplacer
# toutes les valeurs. Sur le VPS, `.env` doit avoir les droits 600.
#
# IMPORTANT (décision D11) : il n'existe qu'une seule variable pour piloter
# les ventes, `SALES_ENABLED`, lue uniquement côté serveur. N'ajoutez jamais
# de variable `NEXT_PUBLIC_SALES_ENABLED` : elle serait figée dans le bundle
# envoyé au navigateur et pourrait devenir incohérente avec le serveur.
#
# SALES_ENABLED est figée AU BUILD (docker-compose.yml passe cette valeur
# comme argument de build, pas seulement comme variable d'environnement du
# conteneur) : changer cette ligne puis redémarrer le conteneur SANS
# reconstruire l'image ne fait rien d'autre que bloquer le démarrage du
# serveur (garde-fou volontaire, voir docs/DECISIONS.md D11). Ouvrir les
# ventes demande donc :
#   docker compose -f docker/docker-compose.yml --env-file .env build app
#   docker compose -f docker/docker-compose.yml --env-file .env up -d app
# Si `config/entreprise.ts` contient encore une valeur "À COMPLÉTER", ce
# build échoue avant même de démarrer.

# --- Application ---
NODE_ENV=production
PORT=3000

# --- Interrupteur de vente et configuration légale (T1.7, D11) ---
# false = mode vitrine (bouton "Me prévenir de la sortie", pas de paiement
# possible). true = "Acheter" affiché, ET config/entreprise.ts vérifiée sans
# valeur provisoire (sinon le build échoue). Voir le bloc IMPORTANT ci-dessus.
SALES_ENABLED=false
# Afficher ou masquer les prix : réglage cosmétique, sans lien avec
# SALES_ENABLED, changeable sans reconstruire.
AFFICHER_PRIX=true

# --- Mot de passe du staging (middleware, T1.3) ---
# Sans ces deux variables, le middleware bloque tout accès (fail-closed).
STAGING_BASIC_AUTH_USER=equipe
STAGING_BASIC_AUTH_PASSWORD=changez-moi

# --- Base de données (Postgres 18, jamais exposée sur Internet, cf. D2) ---
POSTGRES_USER=ecomjdr
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=ecomjdr
DATABASE_URL=postgres://ecomjdr:changez-moi@postgres:5432/ecomjdr

# --- Umami (statistiques, base dédiée sur le même serveur Postgres) ---
UMAMI_POSTGRES_DB=umami
UMAMI_DATABASE_URL=postgres://ecomjdr:changez-moi@postgres:5432/umami
# Chaîne aléatoire longue, générée par ex. avec `openssl rand -hex 32`.
UMAMI_APP_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# --- Stockage privé (T1.5) ---
# Dossier où sont stockés les fichiers privés (kit.pdf, factures…), jamais
# servi en statique. Sur le VPS (staging/production), vaut /data/private
# (chemin absolu, monté par un volume Docker). En local/dev/tests, laisser
# vide pour utiliser data/private/ à la racine du dépôt (déjà dans .gitignore).
STORAGE_PRIVATE_DIR=

# --- Pages du site (T1.6) ---
# true UNIQUEMENT sur le staging : affiche aussi les jeux en statut
# "brouillon" (avec un badge), pour vérifier le rendu avant publication.
# Ne JAMAIS mettre à true en production.
AFFICHER_BROUILLONS=false
# Force une saison sur l'accueil et le menu, pour vérifier son thème sans
# attendre la bonne date ("halloween", "noel", "saint-valentin", "paques",
# ou "aucune"). Laisser vide en production : la saison suit alors la date du
# jour (voir lib/saisons.ts).
SAISON_ACTIVE=

# --- Formulaire de contact (T1.6) ---
# Sans ces trois variables, le formulaire reste fonctionnel (validation,
# anti-spam) mais l'affiche honnêtement au visiteur plutôt que de faire
# semblant d'envoyer : "l'envoi de messages n'est pas encore activé".
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
CONTACT_EMAIL_DESTINATAIRE=

# --- Paiement (T1.8) ---
# Clés de test uniquement en phases 1 et 2 (AGENTS.md section 3 : les clés
# live demandent une validation explicite de l'équipe).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Généré par `stripe listen --print-secret` en local/staging (Stripe ne peut
# pas joindre le staging directement, voir AGENTS.md section 8).
STRIPE_WEBHOOK_SECRET=

# --- SEO technique (T1.12) ---
# Base des URLs absolues (canonical, Open Graph, JSON-LD). À définir avec le
# vrai domaine avant la mise en ligne publique (le domaine n'est pas encore
# acheté, voir docs/A_FAIRE_EQUIPE.md) ; sans valeur, retombe sur
# http://localhost:3000 — sans conséquence tant que le site n'est pas public.
SITE_URL=
# Indexation par les moteurs de recherche : false partout tant que le site
# n'est pas officiellement public (contrairement à SALES_ENABLED, se corrige
# sans reconstruire — mais ne change rien tant que proxy.ts protège encore le
# staging par mot de passe : voir docs/DECISIONS.md D13 et D20).
SITE_PUBLIC=false

# --- Statistiques de visite (T1.14) ---
# Identifiant du site dans Umami (créé une fois via son interface ou son API
# — voir README, section "Statistiques (Umami)"). Sans valeur, le script de
# suivi n'est simplement pas inséré : aucune erreur, juste pas de mesure.
UMAMI_WEBSITE_ID=
