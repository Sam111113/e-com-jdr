# Copier ce fichier en `.env` (jamais commité, voir .gitignore) et remplacer
# toutes les valeurs. Sur le VPS, `.env` doit avoir les droits 600.
#
# IMPORTANT (décision D11) : il n'existe qu'une seule variable pour piloter
# les ventes, `SALES_ENABLED`, lue uniquement côté serveur. N'ajoutez jamais
# de variable `NEXT_PUBLIC_SALES_ENABLED` : elle serait figée dans le bundle
# envoyé au navigateur et pourrait devenir incohérente avec le serveur.
# Cette variable sera introduite par la tâche T1.7, pas par T1.3.

# --- Application ---
NODE_ENV=production
PORT=3000

# --- Mot de passe du staging (middleware, T1.3) ---
# Sans ces deux variables, le middleware bloque tout accès (fail-closed).
STAGING_BASIC_AUTH_USER=equipe
STAGING_BASIC_AUTH_PASSWORD=changez-moi

# --- Base de données (Postgres 18, jamais exposée sur Internet, cf. D2) ---
POSTGRES_USER=ecomjdr
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=ecomjdr
DATABASE_URL=postgres://ecomjdr:changez-moi@postgres:5432/ecomjdr

# --- Umami (statistiques, base dédiée sur le même serveur Postgres) ---
UMAMI_POSTGRES_DB=umami
UMAMI_DATABASE_URL=postgres://ecomjdr:changez-moi@postgres:5432/umami
# Chaîne aléatoire longue, générée par ex. avec `openssl rand -hex 32`.
UMAMI_APP_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# --- Stockage privé (T1.5) ---
# Dossier où sont stockés les fichiers privés (kit.pdf, factures…), jamais
# servi en statique. Sur le VPS (staging/production), vaut /data/private
# (chemin absolu, monté par un volume Docker). En local/dev/tests, laisser
# vide pour utiliser data/private/ à la racine du dépôt (déjà dans .gitignore).
STORAGE_PRIVATE_DIR=

# --- Pages du site (T1.6) ---
# true UNIQUEMENT sur le staging : affiche aussi les jeux en statut
# "brouillon" (avec un badge), pour vérifier le rendu avant publication.
# Ne JAMAIS mettre à true en production.
AFFICHER_BROUILLONS=false
# Force une saison sur l'accueil et le menu, pour vérifier son thème sans
# attendre la bonne date ("halloween", "noel", "saint-valentin", "paques",
# ou "aucune"). Laisser vide en production : la saison suit alors la date du
# jour (voir lib/saisons.ts).
SAISON_ACTIVE=

# --- Formulaire de contact (T1.6) ---
# Sans ces trois variables, le formulaire reste fonctionnel (validation,
# anti-spam) mais l'affiche honnêtement au visiteur plutôt que de faire
# semblant d'envoyer : "l'envoi de messages n'est pas encore activé".
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
CONTACT_EMAIL_DESTINATAIRE=
